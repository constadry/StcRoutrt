## .NET / Visual Studio .gitignore
## На основе github/gitignore VisualStudio.gitignore (сокращённо)

# Локальные настройки пользователя
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.DotSettings.user

# Папки Visual Studio / Rider / VS Code
.vs/
.idea/
.vscode/
*.sln.iml

# Результаты сборки
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
artifacts/

# Тесты и покрытие
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info
.coverage/

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json

# Публикация
*.[Pp]ublish.xml
*.azurePubxml
*.pubxml
*.publishproj
PublishScripts/

# Временные и служебные файлы
*.log
*.tlog
*.tmp
*.tmp_proj
*.cache
*.pdb
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc
ipch/
*.aps
*.ncb
*.opendb
*.opensdf
*.sdf
*.VC.db
*.VC.VC.opendb

# Профилировщики и инструменты
*.psess
*.vsp
*.vspx
*.sap
_ReSharper*/
*.[Rr]e[Ss]harper
_TeamCity*
.cr/personal
*.ncrunch*
_NCrunch_*

# Секреты пользователя и локальные переопределения
*.pfx
*.publishsettings

# ОС
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Явно НЕ игнорируем
!**/Properties/launchSettings.json
!appsettings.Development.json
!**/appsettings.Development.json
